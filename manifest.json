{
  "manifest_version": 3,
  "name": "Notepad Library",
  "description": "A threaded notepad library with offline Word, rich-text, Markdown, and online notepad editing.",
  "version": "10.0",
  "permissions": [
    "webNavigation",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://notepad.pw/*",
    "https://notepad.cc/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Notepad Library",
    "default_popup": "src/notes.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://notepad.pw/*",
        "http://notepad.pw/*",
        "https://notepad.cc/*",
        "http://notepad.cc/*"
      ],
      "js": [
        "src/notepad-sidebar.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/note-editor.html",
        "src/word-editor.html",
        "src/settings.html",
        "vendor/tinymce/*",
        "vendor/tinymce/*/*",
        "vendor/tinymce/*/*/*",
        "vendor/tinymce/*/*/*/*",
        "vendor/tiptap/*",
        "vendor/tiptap/*/*",
        "vendor/milkdown/*",
        "vendor/milkdown/*/*",
        "vendor/ckeditor5/*",
        "vendor/docshift/*",
        "vendor/jsdoc-word/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
